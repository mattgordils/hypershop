{% comment %}
  JSON-LD structured data for SEO / AEO (AI answer engines).

  Output per template:
    product    -> Product (offers, gtin/mpn, brand, images, optional
                  aggregateRating/review) + BreadcrumbList
    collection -> CollectionPage + ItemList + BreadcrumbList
    article    -> BlogPosting + BreadcrumbList
    page       -> WebPage + BreadcrumbList
    index      -> WebSite (+ SearchAction) + Organization (sameAs all socials)

  Review data is app-agnostic: it reads product metafields whose namespace/keys
  are set in Theme settings > SEO (defaults reviews.rating / reviews.rating_count,
  the Shopify-standard namespace that Judge.me, Loox, Okendo, Yotpo sync to).
  Renders only when a rating with a non-zero count exists.
{% endcomment %}

{%- liquid
  assign rev_ns = settings.seo_reviews_namespace | default: 'reviews'
  assign rev_rating_key = settings.seo_reviews_rating_key | default: 'rating'
  assign rev_count_key = settings.seo_reviews_count_key | default: 'rating_count'
-%}

{%- if template.name == 'product' -%}
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'

    comment
      Map the barcode to the right GTIN property by length (EAN-13, UPC-12, etc).
    endcomment
    assign gtin_prop = ''
    assign barcode = current_variant.barcode | strip
    assign barcode_len = barcode | size
    if barcode_len == 14
      assign gtin_prop = 'gtin14'
    elsif barcode_len == 13
      assign gtin_prop = 'gtin13'
    elsif barcode_len == 12
      assign gtin_prop = 'gtin12'
    elsif barcode_len == 8
      assign gtin_prop = 'gtin8'
    endif

    comment Availability mapping. endcomment
    if current_variant.available
      assign availability = 'https://schema.org/InStock'
    elsif current_variant.inventory_policy == 'continue'
      assign availability = 'https://schema.org/BackOrder'
    else
      assign availability = 'https://schema.org/OutOfStock'
    endif

    comment Review data (optional, app-agnostic via metafields). endcomment
    assign rating_field = product.metafields[rev_ns][rev_rating_key]
    assign count_field = product.metafields[rev_ns][rev_count_key]
    assign rating_value = rating_field.value.rating | default: rating_field.value
    assign rating_count = count_field.value | default: 0
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {%- if product.description != blank %}
  "description": {{ product.description | strip_html | truncate: 5000 | json }},
  {%- endif %}
  {%- if current_variant.sku != blank %}
  "sku": {{ current_variant.sku | json }},
  {%- endif %}
  {%- if gtin_prop != blank %}
  "{{ gtin_prop }}": {{ barcode | json }},
  {%- endif %}
  {%- if product.vendor != blank %}
  "mpn": {{ current_variant.sku | default: product.handle | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- else %}
  "brand": {
    "@type": "Brand",
    "name": {{ shop.name | json }}
  },
  {%- endif %}
  {%- if product.featured_media %}
  "image": [
    {%- for media in product.media limit: 5 -%}
      {{ media | image_url: width: 1200, height: 1200 | prepend: 'https:' | json }}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif %}
  {%- if rating_value != blank and rating_count != blank and rating_count > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ rating_value }}",
    "reviewCount": "{{ rating_count }}",
    "bestRating": "5",
    "worstRating": "1"
  },
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": {{ current_variant.price | divided_by: 100.0 }},
    "priceValidUntil": "{{ price_valid_until }}",
    "availability": "{{ availability }}",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  {%- if product.variants.size > 1 -%},
  "hasVariant": [
    {%- for variant in product.variants -%}
    {
      "@type": "Product",
      "name": {{ variant.title | json }},
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      "offers": {
        "@type": "Offer",
        "price": {{ variant.price | divided_by: 100.0 }},
        "priceCurrency": "{{ cart.currency.iso_code }}",
        "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}"
      }
    }
    {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif %}
}
</script>
{% render 'breadcrumbs', format: 'json' %}

{%- elsif template.name == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": "{{ shop.url }}{{ collection.url }}",
  {%- if collection.description != blank %}
  "description": {{ collection.description | strip_html | truncate: 5000 | json }},
  {%- endif %}
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products limit: 25 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": "{{ shop.url }}{{ product.url }}",
        "name": {{ product.title | json }}
      }
      {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
{% render 'breadcrumbs', format: 'json' %}

{%- elsif template.name == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "url": "{{ shop.url }}{{ article.url }}",
  "mainEntityOfPage": "{{ shop.url }}{{ article.url }}",
  {%- if article.excerpt_or_content != blank %}
  "description": {{ article.excerpt_or_content | strip_html | truncate: 5000 | json }},
  {%- endif %}
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "inLanguage": "{{ request.locale.iso_code }}",
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
    {%- if settings.favicon -%},
    "logo": {
      "@type": "ImageObject",
      "url": "{{ settings.favicon | image_url: width: 200, height: 200 | prepend: 'https:' }}"
    }
    {%- endif -%}
  }
}
</script>
{% render 'breadcrumbs', format: 'json' %}

{%- elsif template.name == 'page' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ page.title | json }},
  "url": "{{ shop.url }}{{ page.url }}"
  {%- if page.content != blank -%},
  "description": {{ page.content | strip_html | truncate: 300 | json }}
  {%- endif %}
}
</script>
{% render 'breadcrumbs', format: 'json' %}

{%- elsif template.name == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": "{{ shop.url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
  {%- liquid
    assign social_urls = '' | split: ''
    if settings.social_facebook_link != blank
      assign social_urls = social_urls | concat: settings.social_facebook_link | split: '|||'
    endif
    if settings.social_instagram_link != blank
      assign social_urls = social_urls | concat: settings.social_instagram_link | split: '|||'
    endif
    if settings.social_twitter_link != blank
      assign social_urls = social_urls | concat: settings.social_twitter_link | split: '|||'
    endif
    if settings.social_pinterest_link != blank
      assign social_urls = social_urls | concat: settings.social_pinterest_link | split: '|||'
    endif
    if settings.social_tiktok_link != blank
      assign social_urls = social_urls | concat: settings.social_tiktok_link | split: '|||'
    endif
    if settings.social_youtube_link != blank
      assign social_urls = social_urls | concat: settings.social_youtube_link | split: '|||'
    endif
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": "{{ shop.url }}",
  {%- if settings.favicon %}
  "logo": "{{ settings.favicon | image_url: width: 200, height: 200 | prepend: 'https:' }}",
  {%- endif %}
  {%- if social_urls.size > 0 %}
  "sameAs": [
    {%- for url in social_urls -%}
      {{ url | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- else %}
  "sameAs": []
  {%- endif %}
}
</script>
{%- endif -%}
