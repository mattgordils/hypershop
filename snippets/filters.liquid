{%- comment -%}
  `filters` param lets this work for collections AND search; defaults to the collection.
  `id_prefix` namespaces every element id so the snippet can be rendered more than once
  on a page (e.g. the mobile filter bar + the desktop sidebar) without duplicate ids —
  duplicate ids would make every `<label for>` point at the first instance's input.

  `section_id` links the instance to its <collection-grid>. It's how instances rendered
  outside the grid element (a filter panel/drawer) are found, wired up and kept in sync,
  so always pass it.

  Pass `sort_options` (+ `sort_by`) to list sort as a group alongside the filters —
  useful in the drawer, where there's no room for a separate sort dropdown. The grid
  reads sort out of the same form, so it needs no extra wiring.
{%- endcomment -%}
{%- assign filter_list = filters | default: collection.filters -%}
{%- assign uid = id_prefix | default: 'filters' -%}
{%- comment -%}
  Theme settings → Filters → Collapsible filter groups. When off, each group keeps the
  same markup but loses its trigger and starts expanded, so collapsible-item has nothing
  to toggle and the group simply stays open.
{%- endcomment -%}
{%- assign filters_collapsible = true -%}
{%- if settings.filter_collapsible == false -%}{%- assign filters_collapsible = false -%}{%- endif -%}
{%- assign group_open_state = 'true' -%}
{%- unless filters_collapsible -%}{%- assign group_open_state = 'false' -%}{%- endunless -%}
{%- assign show_sort = false -%}
{%- if sort_options.size > 0 -%}{%- assign show_sort = true -%}{%- endif -%}
{%- comment -%} Matched against filter.label. Theme settings → Filters → Hidden filters. {%- endcomment -%}
{%- assign hide_these_filters = settings.filter_hidden_labels | replace: ', ', ',' | split: ',' -%}
{%- assign has_active_filters = false -%}
{%- for filter in filter_list -%}
  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != null or filter.max_value.value != null -%}
      {%- assign has_active_filters = true -%}
    {%- endif -%}
  {%- else -%}
    {%- for filter_value in filter.active_values -%}
      {%- assign has_active_filters = true -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

<div
  id='collectionFilters-{{ uid }}'
  class='collection-filters'
  data-filters
  data-filters-uid='{{ uid }}'
  data-filters-for='{{ section_id }}'
>
  {% if has_active_filters %}
    <div class='flex flex-wrap gap-3 border-hr-color'>
      <button
        type='button'
        data-clear-all-filters
        class='h6 border-b border-dashed transition border-hr-color hover:border-current hover:text-error'
      >
        Clear All
      </button>
      {%- for filter in filter_list -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != null or filter.max_value.value != null -%}
            <a
              href='{{ filter.url_to_remove }}'
              class='remove-filter flex gap-1 items-center justify-start body-small leading-none text-light-text-color hover:text-error transition'
            >
              {%- assign min_value = filter.min_value.value | default: 0 -%}
              {%- assign max_value = filter.max_value.value | default: filter.range_max -%}
              {{ min_value | money }}—{{ max_value | money }}
              <div class='h6 text-center'>{% render 'icon-material', size: '1em', class: 'block' %}</div>
            </a>
          {%- endif -%}
        {%- else -%}
          {%- for filter_value in filter.active_values -%}
            <a
              href='{{ filter_value.url_to_remove }}'
              class='remove-filter flex gap-1 items-center justify-start body-small leading-none text-light-text-color hover:text-error transition'
              title='Remove {{ filter.label }} filter'
            >
              {{ filter_value.label }}
              <div class='h6 text-center pointer-events-none'>{% render 'icon-material', size: '1em', class: 'block' %}</div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {% endif %}

  {%- comment -%}
    Sort lives inside the form so each instance's radios form their own group — outside
    a form they'd all share one document-level group, and two instances rendering the
    same option `checked` would fight over it.
  {%- endcomment -%}
   
  <form class="{{ filters_classname }} {% if has_active_filters %} mb-4{% endif %}">
    {%- if show_sort -%}
      <collapsible-item class='border-b border-hr-color' data-filter-key='sort-by'>
        <summary
          {% if filters_collapsible %}data-collapsible='trigger'{% endif %}
          class='{% if filters_collapsible %}cursor-pointer {% endif %}block body font-medium pb-4'
        >
          <div class='flex gap-3 items-center justify-between'>
            <span>Sort By</span>
            {% if filters_collapsible %}
              <div data-collapsible='icon' class='w-[10px] rotate-180'>
                {% render 'icon-material', icon: 'keyboard_arrow_down', class: 'arrow transition rotate-180' %}
              </div>
            {% endif %}
          </div>
        </summary>

        <div data-collapsible='content' aria-hidden='{{ group_open_state }}'>
          <div>
            <div class='pb-5'>
              <ul>
                {%- for option in sort_options -%}
                  {%- liquid
                    # render params take plain values only — no filters, no comparisons
                    assign sort_id = 'Filter-' | append: uid | append: '-sort-' | append: forloop.index
                    assign sort_checked = false
                    if option.value == sort_by
                      assign sort_checked = true
                    endif
                  -%}
                  <li class='filter-item body'>
                    {% render 'filter-option',
                      type: 'radio',
                      id: sort_id,
                      name: 'sort_by',
                      value: option.value,
                      label: option.name,
                      checked: sort_checked
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>
      </collapsible-item>
    {%- endif -%}

    {%- for filter in filter_list -%}
      {%- unless hide_these_filters contains filter.label -%}
        {%- comment -%}for backward compatibiilty with legacy use of product set id filter{%- endcomment -%}
        {%- liquid
          # Instance-independent key: lets the grid keep a group's expanded state in
          # sync between instances, and restore it after a filter re-renders the section.
          assign filter_key = filter.param_name | default: filter.label | handle

          assign is_availability = false
          assign in_stock_value = null
          if filter.type == 'list'
            for fv in filter.values
              if fv.param_name contains 'availability'
                assign is_availability = true
                if fv.value == 1 or fv.value == '1'
                  assign in_stock_value = fv
                endif
              endif
            endfor
          endif
        -%}
        {% if is_availability and in_stock_value %}
          {%- comment -%} Availability rendered as a single "Hide out of stock" toggle (applies in-stock only) {%- endcomment -%}
          {%- assign oos_id = 'Filter-' | append: uid | append: '-hide-oos' -%}
          <div class='border-b border-hr-color py-4'>
            {% render 'filter-option',
              type: 'checkbox',
              id: oos_id,
              name: in_stock_value.param_name,
              value: in_stock_value.value,
              label: 'Hide out of stock',
              checked: in_stock_value.active,
              class: 'body font-medium'
            %}
          </div>
        {% elsif filter.type != 'boolean' %}
          <collapsible-item class='border-b border-hr-color' data-filter-key='{{ filter_key }}'>
            <summary
              {% if filters_collapsible %}data-collapsible='trigger'{% endif %}
              class='{% if filters_collapsible %}cursor-pointer {% endif %}block body font-medium {% if forloop.index == 1 and show_sort == false %}pb-4{% else %}py-4{% endif %}'
            >
              <div class='flex gap-3 items-center justify-between'>
                <span>{{ filter.label }}</span>
                {% if filters_collapsible %}
                  <div data-collapsible='icon' class='w-[10px] rotate-180'>
                    {% render 'icon-material', icon: 'keyboard_arrow_down', class: 'arrow transition rotate-180' %}
                  </div>
                {% endif %}

                {%- if filter.active_values.size > 0 -%}
                  <span class='hidden'>({{ filter.active_values.size }})</span>
                {%- endif -%}
              </div>
            </summary>

            <div
              data-collapsible='content'
              aria-hidden='{{ group_open_state }}'
            >
              <div>
                <div class='pb-5'>
                  {% comment %}
                    <div>
                      <p>{{ filter.active_values.size }} selected</p>
                      {%- if filter.active_values.size > 0 -%}
                        <p><a href="{{ filter.url_to_remove }}">Reset</a></p>
                      {%- endif -%}
                    </div>
                  {% endcomment %}
                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      <ul class='{% if filter.label == 'Color' %}flex flex-wrap gap-x-3 justify-start{% endif %}'>
                        {%- liquid
                          assign all_id = 'Filter-' | append: uid | append: '-' | append: filter.param_name | append: '-all'
                          assign all_checked = false
                          if filter.active_values.size < 1
                            assign all_checked = true
                          endif
                        -%}
                        <li class='filter-item body {% if filter.label == 'Color' %}w-[40%] grow min-w-[100px]{% endif %}'>
                          {% render 'filter-option',
                            type: 'checkbox',
                            id: all_id,
                            name: filter.param_name,
                            value: 'all',
                            label: 'All',
                            checked: all_checked
                          %}
                        </li>
                        {%- for filter_value in filter.values -%}
                          {%- liquid
                            assign filter_disabled = false
                            if filter_value.count == 0 and filter_value.active == false
                              assign filter_disabled = true
                            endif

                            assign value_id = 'Filter-' | append: uid | append: '-' | append: filter.param_name | append: '-' | append: forloop.index

                            assign value_marker = 'check'
                            assign color = null
                            if filter.label == 'Color'
                              assign value_marker = 'swatch'
                              assign color = shop.metaobjects.color_list[filter_value.label]
                            endif
                          -%}
                          <li class='filter-item body {% if filter.label == 'Color' %}w-[40%] grow min-w-[100px]{% endif %}'>
                            {% render 'filter-option',
                              type: 'checkbox',
                              id: value_id,
                              name: filter_value.param_name,
                              value: filter_value.value,
                              label: filter_value.label,
                              checked: filter_value.active,
                              disabled: filter_disabled,
                              marker: value_marker,
                              color: color
                            %}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'price_range' -%}
                      {% render 'filter-price', filter: filter, uid: uid %}
                  {%- endcase -%}
                </div>
              </div>
            </div>
          </collapsible-item>
        {% else %}
          <div data-collapsible='trigger' class='border-b border-hr-color block body font-medium'>
            <div class='flex gap-4 items-center justify-between filter-item true-false relative {% if forloop.index == 1 and show_sort == false %}pb-4{% else %}py-4{% endif %}'>
              {{ filter.label }}
              <label
                for='Filter-{{ uid }}-{{ filter.param_name }}-{{ filter.true_value.value }}'
                class='tf-label label-true'
              >
                <input
                  type='radio'
                  class='hidden'
                  name='{{ filter.param_name }}'
                  value='{{ filter.true_value.value }}'
                  data-value='true'
                  id='Filter-{{ uid }}-{{ filter.param_name }}-{{ filter.true_value.value }}'
                  {% if filter.true_value.active -%}
                    checked
                  {%- endif %}
                  {% if filter.true_value.count == 0 and filter.true_value.active == false -%}
                    disabled
                  {%- endif -%}

                ><span class='hidden'>{{ filter.true_value.label }}</span>
              </label>

              <label
                for='Filter-{{ uid }}-{{ filter.param_name }}-{{ filter.false_value.value }}'
                class='tf-label label-false'
              >
                <input
                  type='radio'
                  class='hidden'
                  name='{{ filter.param_name }}'
                  value='{{ filter.false_value.value }}'
                  data-value='false'
                  id='Filter-{{ uid }}-{{ filter.param_name }}-{{ filter.false_value.value }}'
                  {% if filter.false_value.active -%}
                    checked
                  {%- endif %}
                  {% if filter.false_value.count == 0 and filter.false_value.active == false -%}
                    disabled
                  {%- endif %}

                ><span class='hidden'>{{ filter.false_value.label }}</span>
              </label>

              <div class='flex items-center justify-end gap-2'>
                <div class='relative smallcaps text-light-text-color'>
                  <span class='block transition toggle-label off'>Off</span>
                  <span class='block transition toggle-label on absolute top-0 right-0'>On</span>
                </div>
                <div class='toggle h-[10px] w-[20px] rounded-full bg-hr-color'>
                  <div
                    class='transition w-[10px] h-[10px] border-[2px] rounded-full border-hr-color bg-text-color'
                  ></div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {%- endunless -%}
    {%- endfor -%}
  </form>
</div>
