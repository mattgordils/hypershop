{%-liquid
	if layout != blank
		if layout == 'cover'
			assign object_fit = 'object-cover'
		endif
		if layout == 'contain'
			assign object_fit = 'object-contain'
		endif
	endif

	assign video_width = width | default: 1200
	assign video_poster_width = video_width | append: 'x'
	comment
		`default` treats false as absent, so `autoplay | default: true` forced autoplay back
		on for any caller that explicitly asked to turn it off. Test for false instead —
		nil still falls through to the default.
	endcomment
	assign video_autoplay = true
	if autoplay == false
		assign video_autoplay = false
	endif
	assign video_loop = true
	if loop == false
		assign video_loop = false
	endif
	assign video_muted = true
	if muted == false
		assign video_muted = false
	endif
	assign video_controls = false
	if controls
		assign video_controls = true
	endif

	assign video_class = class
	if layout == 'cover' or layout == 'contain'
		assign video_class = video_class | append: ' ' | append: object_fit | append: ' absolute top-0 left-0 w-full h-full'
	endif
-%}

{% comment %} section.settings.video.aspect_ratio {% endcomment %}

{{ src | video_tag:
	image_size: video_poster_width,
	autoplay: video_autoplay,
	loop: video_loop,
	muted: video_muted,
	controls: video_controls,
	class: video_class
}}