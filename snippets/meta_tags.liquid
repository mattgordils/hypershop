{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  comment
    Pick a single share image (most platforms only use the first og:image).
    Multiple product images live in the JSON-LD Product schema instead.
  endcomment
  assign share_image = ''
  assign share_alt = og_title
  if request.page_type == 'product' and product.featured_media
    assign share_image = product.featured_media.preview_image
    assign share_alt = product.featured_media.alt | default: product.title
  elsif request.page_type == 'article' and article.image
    assign share_image = article.image
    assign share_alt = article.image.alt | default: article.title
  elsif page_image
    assign share_image = page_image
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if share_image != blank %}
  <meta property="og:image" content="{{ share_image | image_url: width: 1200 | prepend: 'https:' }}">
  <meta property="og:image:secure_url" content="{{ share_image | image_url: width: 1200 | prepend: 'https:' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: share_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ share_alt | escape }}">
{%- endif %}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if share_image != blank %}
  <meta name="twitter:image" content="{{ share_image | image_url: width: 1200 | prepend: 'https:' }}">
  <meta name="twitter:image:alt" content="{{ share_alt | escape }}">
{%- endif %}
