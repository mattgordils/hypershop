[
  {
    "name": "theme_info",
    "theme_name": "Total Control",
    "theme_version": "1.0.0",
    "theme_author": "Studio Hyperlink",
    "theme_documentation_url": "https://github.com/mattgordils/hypershop",
    "theme_support_email": "matt@hyperlinknyc.com"
  },
  {
    "name": "Overview",
    "settings": [
      {
        "type": "paragraph",
        "content": "Theme settings control your store's global styles — colors, color schemes, and typography — which cascade across every page of your site."
      },
      {
        "type": "paragraph",
        "content": "To preview them live as you edit, create a page using the “Styleguide” template and open it in the editor. It updates in real time as you change settings here."
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "128×128px PNG recommended. Shown in browser tabs and bookmarks."
      },
      {
        "type": "image_picker",
        "id": "touch_icon",
        "label": "Touch icon (iOS / PWA)",
        "info": "Square opaque PNG, 512×512px recommended. Used when the site is added to a mobile home screen. Falls back to the favicon if empty."
      }
    ]
  },
  {
    "name": "Color Schemes",
    "settings": [
      {
        "type": "paragraph",
        "content": "The first scheme is the site-wide default. Color schemes can be applied to sections throughout your store. Add as many schemes as you need."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
          { "type": "color_background", "id": "background_gradient", "label": "Background gradient", "info": "Optional. Overrides the solid background with a gradient." },
          { "type": "color", "id": "text", "label": "Text", "default": "#000000" },
          { "type": "color", "id": "accent", "label": "Accent", "info": "Links and highlights.", "default": "#000000" },

          { "type": "header", "content": "Line & Subtle Background", "info": "Optional — leave blank to auto-derive from the Text and Background colors." },
          { "type": "color", "id": "hr", "label": "Line / border" },
          { "type": "color", "id": "light_grey", "label": "Subtle background" },

          { "type": "header", "content": "Status Colors", "info": "Optional — each falls back to the global Error / Success color in Theme settings → Colors." },
          { "type": "color", "id": "error", "label": "Error" },
          { "type": "color", "id": "success", "label": "Success" },

          { "type": "header", "content": "Primary Button", "info": "Set per scheme." },
          { "type": "color", "id": "primary_button_background", "label": "Background", "default": "#000000" },
          { "type": "color", "id": "primary_button_label", "label": "Label", "default": "#FFFFFF" },
          { "type": "color", "id": "primary_button_border", "label": "Border", "default": "#000000" },

          { "type": "header", "content": "Primary Button Hover", "info": "Optional — leave blank to fade toward the Accent color." },
          { "type": "color", "id": "primary_button_hover_background", "label": "Background" },
          { "type": "color", "id": "primary_button_hover_label", "label": "Label" },
          { "type": "color", "id": "primary_button_hover_border", "label": "Border" },

          { "type": "header", "content": "Secondary Button", "info": "Set per scheme. Leave Background blank for a transparent (outlined) button." },
          { "type": "color", "id": "secondary_button_background", "label": "Background" },
          { "type": "color", "id": "secondary_button_label", "label": "Label", "default": "#000000" },
          { "type": "color", "id": "secondary_button_border", "label": "Border", "default": "#000000" },

          { "type": "header", "content": "Secondary Button Hover", "info": "Optional — leave blank to fade toward the Accent color." },
          { "type": "color", "id": "secondary_button_hover_background", "label": "Background" },
          { "type": "color", "id": "secondary_button_hover_label", "label": "Label" },
          { "type": "color", "id": "secondary_button_hover_border", "label": "Border" }
        ],
        "role": {
          "background": { "solid": "background", "gradient": "background_gradient" },
          "text": "text",
          "primary_button": "primary_button_background",
          "on_primary_button": "primary_button_label",
          "primary_button_border": "primary_button_border",
          "secondary_button": "secondary_button_background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_border",
          "links": "accent",
          "icons": "text"
        }
      },
      {
        "type": "header",
        "content": "Global Colors",
        "info": "These two are global status colors (each color scheme can override them)."
      },
      { "type": "color", "id": "color_error", "label": "Error", "default": "#cc0000" },
      { "type": "color", "id": "color_success", "label": "Success", "default": "#008000" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Headings font", "default": "assistant_n4" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "assistant_n4" },
      { "type": "font_picker", "id": "font_button", "label": "Button font", "default": "assistant_n4" }
      , { "type": "url", "id": "custom_font_heading_url", "label": "Custom headings font (.woff2 URL)", "info": "Non–Theme-Store builds only. Upload a .woff2 to Content → Files and paste its URL to override the headings font above. See README-custom-fonts.md." }
      , { "type": "url", "id": "custom_font_body_url", "label": "Custom body font (.woff2 URL)", "info": "Non–Theme-Store builds only. Overrides the body font with a .woff2 uploaded to Content → Files." }
      , { "type": "url", "id": "custom_font_button_url", "label": "Custom button font (.woff2 URL)", "info": "Non–Theme-Store builds only. Overrides the button font with a .woff2 uploaded to Content → Files." }
    ]
  },
