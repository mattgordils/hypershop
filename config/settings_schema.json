[
  {
    "name": "theme_info",
    "theme_name": "Total Control",
    "theme_version": "1.0.0",
    "theme_author": "Studio Hyperlink",
    "theme_documentation_url": "https://github.com/mattgordils/hypershop",
    "theme_support_email": "matt@hyperlinknyc.com"
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "128×128px PNG recommended."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "info": "Used for buttons, links, and highlights.",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_light_grey",
        "label": "Light grey",
        "info": "Used for subtle backgrounds and alternate section fills.",
        "default": "#f2f2f2"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error",
        "default": "#cc0000"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#008000"
      }
    ]
  },
  {
    "name": "Schemes",
    "settings": [
      {
        "type": "paragraph",
        "content": "Color schemes can be applied to sections throughout your store. Add as many schemes as you need."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "info": "Used for buttons and highlights.",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "accent",
          "on_primary_button": "button_label",
          "primary_button_border": "accent",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "accent",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Headings",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_body_size",
        "label": "Body font size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "H1",
    "settings": [
      {
        "type": "header",
        "content": "Size"
      },
      {
        "type": "range",
        "id": "h1_size_mobile",
        "label": "Mobile size",
        "min": 16,
        "max": 120,
        "step": 1,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "h1_size_desktop",
        "label": "Desktop size",
        "min": 16,
        "max": 200,
        "step": 1,
        "unit": "px",
        "default": 70
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "select",
        "id": "h1_weight",
        "label": "Weight",
        "default": "400",
        "options": [
          { "value": "100", "label": "100 — Thin" },
          { "value": "200", "label": "200 — Extra Light" },
          { "value": "300", "label": "300 — Light" },
          { "value": "400", "label": "400 — Regular" },
          { "value": "500", "label": "500 — Medium" },
          { "value": "600", "label": "600 — Semi Bold" },
          { "value": "700", "label": "700 — Bold" },
          { "value": "800", "label": "800 — Extra Bold" },
          { "value": "900", "label": "900 — Black" }
        ]
      },
      {
        "type": "select",
        "id": "h1_style",
        "label": "Style",
        "default": "normal",
        "options": [
          { "value": "normal", "label": "Normal" },
          { "value": "italic", "label": "Italic" }
        ]
      },
      {
        "type": "checkbox",
        "id": "h1_uppercase",
        "label": "Uppercase",
        "default": false
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "h1_letter_spacing",
        "label": "Letter spacing",
        "info": "As a percentage — 10 = 0.1em, -4 = -0.04em",
        "min": -10,
        "max": 30,
        "step": 1,
        "unit": "%",
        "default": -4
      },
      {
        "type": "range",
        "id": "h1_line_height",
        "label": "Line height",
        "info": "As a percentage — 100 = 1em, 150 = 1.5em",
        "min": 60,
        "max": 200,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "header",
        "content": "Grid — Mobile"
      },
      {
        "type": "range",
        "id": "mobile_margin",
        "label": "Mobile margin",
        "info": "Horizontal padding on the left and right edges.",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "mobile_gutter",
        "label": "Mobile gutter",
        "info": "Gap between grid columns.",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "header",
        "content": "Grid — Desktop"
      },
      {
        "type": "range",
        "id": "desktop_margin",
        "label": "Desktop margin",
        "info": "Horizontal padding on the left and right edges.",
        "min": 0,
        "max": 400,
        "step": 4,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "desktop_gutter",
        "label": "Desktop gutter",
        "info": "Gap between grid columns.",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20
      },
      {
        "type": "header",
        "content": "Page"
      },
      {
        "type": "select",
        "id": "site_max_width",
        "label": "Maximum page width",
        "default": "1600px",
        "options": [
          {
            "value": "1200px",
            "label": "Narrow (1200px)"
          },
          {
            "value": "1440px",
            "label": "Standard (1440px)"
          },
          {
            "value": "1600px",
            "label": "Wide (1600px)"
          },
          {
            "value": "1920px",
            "label": "Extra wide (1920px)"
          },
          {
            "value": "100%",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Border radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "Button border radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "header_height",
        "label": "Header height",
        "min": 48,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 60
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter (X)",
        "info": "https://twitter.com/shopify"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://www.facebook.com/shopify"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://www.instagram.com/shopify"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://www.pinterest.com/shopify"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://www.tiktok.com/@shopify"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://www.youtube.com/shopify"
      }
    ]
  }
]
