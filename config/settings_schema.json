      { "type": "color", "id": "color_success", "label": "Success", "default": "#008000" }
    ]
  },
  {
    "name": "Schemes",
    "settings": [
      {
        "type": "paragraph",
        "content": "Color schemes can be applied to sections throughout your store. Add as many schemes as you need."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
          { "type": "color", "id": "text", "label": "Text", "default": "#000000" },
          { "type": "color", "id": "accent", "label": "Accent", "info": "Used for buttons and highlights.", "default": "#000000" },
          { "type": "color", "id": "button_label", "label": "Button label", "default": "#FFFFFF" }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "accent",
          "on_primary_button": "button_label",
          "primary_button_border": "accent",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "accent",
          "icons": "text"
        }
      }
    ]
  },
