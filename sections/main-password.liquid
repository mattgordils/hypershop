{% comment %}
  Password page (shown when the store is password protected). Rendered inside the
  minimal password layout, so this section provides the full page: logo, message,
  the storefront password form, an optional newsletter signup, and the owner login.
{% endcomment %}

<div class="{{ section.settings.color_scheme }} min-h-dvh flex flex-col items-center justify-center text-center px-margin py-v-space">
  <div class="max-w-narrow mx-auto w-full flex flex-col items-center gap-v-space-sm">
    <div class="w-[180px] max-w-full">
      {% render 'logo' %}
    </div>

    <div class="flex flex-col gap-gutter">
      {% if section.settings.heading != blank %}
        <h1 class="h2">{{ section.settings.heading }}</h1>
      {% else %}
        <h1 class="h2">{{ shop.name }}</h1>
      {% endif %}

      {% if section.settings.message != blank %}
        <div class="rte body">
          {{ section.settings.message }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_newsletter %}
      <div class="w-full max-w-[28rem] mx-auto flex flex-col gap-2">
        {% if section.settings.newsletter_heading != blank %}
          <p class="h6">{{ section.settings.newsletter_heading }}</p>
        {% endif %}
        {% form 'customer', class: 'w-full flex flex-col gap-2' %}
          <input type="hidden" name="contact[tags]" value="newsletter, password page">
          <div class="flex gap-2">
            <label class="sr-only" for="PasswordNewsletterEmail">Email</label>
            <input
              type="email"
              id="PasswordNewsletterEmail"
              name="contact[email]"
              class="grow"
              value="{{ form.email }}"
              placeholder="Enter your email"
              required
              aria-required="true"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
            >
            <button type="submit" class="button shrink-0">Notify me</button>
          </div>
          {% if form.posted_successfully? %}
            <p class="body-small opacity-70" role="status">Thanks — we will keep you posted.</p>
          {% elsif form.errors %}
            <p class="body-small text-error" role="alert">{{ form.errors | default_errors }}</p>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    <div class="w-full max-w-[28rem] mx-auto flex flex-col gap-2">
      <p class="h6">{{ section.settings.password_heading | default: 'Enter using password' }}</p>
      {% form 'storefront_password', class: 'w-full flex flex-col gap-2' %}
        {% if form.errors %}
          <p class="body-small text-error" role="alert">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="flex gap-2">
          <label class="sr-only" for="StorefrontPassword">Password</label>
          <input
            type="password"
            id="StorefrontPassword"
            name="password"
            class="grow"
            placeholder="Your password"
            autocomplete="current-password"
            aria-label="Store password"
          >
          <button type="submit" class="button shrink-0">Enter</button>
        </div>
      {% endform %}
    </div>

    <p class="body-small opacity-70">
      Are you the store owner?
      <a href="/admin" class="animate-underline underlined">Log in here</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the shop name"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Opening soon. Enter the store password to take a look around.</p>"
    },
    {
      "type": "text",
      "id": "password_heading",
      "label": "Password Form Heading",
      "default": "Enter using password"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Email Signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Signup Heading",
      "default": "Be the first to know when we launch"
    },
    {
      "type": "header",
      "content": "Spacing & Sizing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Color",
      "default": "theme-default"
    }
  ]
}
{% endschema %}
