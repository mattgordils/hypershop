{% comment %}
  Contact form. Shopify's native contact form: it POSTs to /contact and emails the
  submission to the store's sender email address (Settings → Notifications). Nothing is
  stored in the admin, so the email IS the record.

  contact-form.js posts it in place and reads the outcome from the response, so there's no
  page reload — but the form works untouched with JavaScript off, which is why nothing here
  depends on it. Both paths land on the same server-rendered status markup.
{% endcomment %}

<script src="{{ 'contact-form.js' | asset_url }}" defer></script>

{% capture spacing_class %}
  {% render 'util-section-spacing', space: section.settings.section_spacing %}
{% endcapture %}

{%- liquid
  assign status_id = 'ContactStatus-' | append: section.id
  assign errors_id = 'ContactErrors-' | append: section.id
  assign form_id = 'ContactForm-' | append: section.id
  assign success_text = section.settings.success_message | default: 'Thanks for reaching out — we will be in touch soon.'
-%}

<div class="{{ section.settings.color_scheme }} {{ spacing_class }} px-margin">
  <div class="max-w-narrow mx-auto space-y-v-space-sm">
    {% content_for 'block',
      type: '_text-lockup',
      id: 'text-lockup',
      classname: 'text-balance'
    %}

    {%- comment -%} No `| escape` after `| t` — the t filter already escapes, and the pair double-encodes. {%- endcomment -%}
    <contact-form data-error-text="{{ 'general.contact.error' | t }}">
    {% form 'contact', id: form_id, class: 'flex flex-col gap-gutter' %}
      {%- comment -%}
        Both states are always rendered so JS has somewhere to write and the transition has
        something to animate — a node toggled with `hidden` jumps. Collapsed to 0fr rather
        than display:none, which is the part that can actually animate. Empty when closed,
        so the live regions announce nothing until there is something to say.
      {%- endcomment -%}
      <div
        id="{{ status_id }}"
        class="contact-form__status"
        data-contact-success
        data-open="{% if form.posted_successfully? %}true{% else %}false{% endif %}"
      >
        <div>
          <p class="theme-light-grey rounded p-gutter body" role="status">{{ success_text }}</p>
        </div>
      </div>

      <div
        class="contact-form__status"
        data-contact-error-wrap
        data-open="{% if form.errors %}true{% else %}false{% endif %}"
      >
        <div>
          <div id="{{ errors_id }}" class="text-error body-small" role="alert">
            {%- if form.errors -%}{{ form.errors | default_errors }}{%- endif -%}
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <label for="ContactName">Name</label>
        <input
          type="text"
          id="ContactName"
          name="contact[name]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          autocomplete="name"
        >
      </div>

      <div class="flex flex-col gap-1">
        <label for="ContactEmail">Email <span aria-hidden="true">*</span></label>
        <input
          type="email"
          id="ContactEmail"
          name="contact[email]"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          required
          aria-required="true"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactEmailError"{% endif %}
        >
        {% if form.errors contains 'email' %}
          <p id="ContactEmailError" class="text-error body-small" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {% endif %}
      </div>

      <div class="flex flex-col gap-1">
        <label for="ContactPhone">Phone</label>
        <input
          type="tel"
          id="ContactPhone"
          name="contact[phone]"
          value="{{ form.phone }}"
          autocomplete="tel"
        >
      </div>

      <div class="flex flex-col gap-1">
        <label for="ContactBody">Message <span aria-hidden="true">*</span></label>
        <textarea
          id="ContactBody"
          name="contact[body]"
          rows="6"
          required
          aria-required="true"
        >{{ form.body }}</textarea>
      </div>

      <div>
        <button type="submit" class="button">
          {{ section.settings.button_label | default: 'Send' }}
        </button>
      </div>
    {% endform %}
    </contact-form>
  </div>
</div>

{% stylesheet %}
  /* 0fr → 1fr is the collapse that can actually be transitioned; display:none and the
     hidden attribute both jump. The inner wrapper is what clips during the animation. */
  .contact-form__status {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--md-speed) ease-in-out,
      opacity var(--md-speed) ease-in-out;
  }

  .contact-form__status > * {
    min-height: 0;
    overflow: hidden;
  }

  .contact-form__status[data-open='true'] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form__status {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section-main-contact",
  "blocks": [
    { "type": "@app" },
    { "type": "_text-lockup" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit Button Label",
      "default": "Send"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for reaching out — we will be in touch soon."
    },
    {
      "type": "header",
      "content": "Spacing & Sizing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Color",
      "default": "theme-default"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "default": "medium",
      "label": "Section Spacing",
      "info": "This can be used to adjust or remove the space below this section",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Slim", "value": "slim" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "blocks": [
        {
          "id": "text-lockup",
          "type": "_text-lockup",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}
