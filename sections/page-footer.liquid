{% liquid
	assign columns = section.blocks | where: 'type', 'menu'

	# Type sizes for the menu columns come from Theme editor settings, so the classes
	# arrive as plain strings.
	assign list_title_class = section.settings.list_title_class | default: 'h6'
	assign list_item_class = section.settings.list_item_class | default: 'body-small'
%}

{%- comment -%}
	Tailwind safelist. The two classes above are chosen in the editor, so the scanner
	can't see them at the point of use — listing them here keeps the utilities in the
	build: h1 h2 h3 h4 h5 h6 body-tiny body-small body body-medium body-large
{%- endcomment -%}

<div id="footer" class="p-margin {{ section.settings.color_scheme }}" role="contentinfo">
	{% comment %} tiny links {% endcomment %}
	<div class="mb-v-space grid grid-cols-2 lg:grid-cols-12 gap-x-gutter gap-y-v-space">

		<div class="col-span-2 lg:col-span-6 lg:grid lg:grid-cols-6 lg:gap-x-gutter">
			<div class="flex flex-col gap-y-3 lg:col-span-4">
				{%- comment -%}
					Matches the menu column headings below — same tag and classes — so the
					newsletter reads as one more footer column rather than its own thing.
					The parent's gap handles the spacing, hence no margin here.
				{%- endcomment -%}
				{% if section.settings.text_title != blank %}
					<h6 class="h6">{{ section.settings.text_title }}</h6>
				{% endif %}
				<div class="body">
					{{ section.settings.text }}
				</div>
				{% render 'newsletter-form',
					id_prefix: 'footer',
					confirm_text: section.settings.text_confirm
				%}
			</div>
		</div>

		<div class="lg:col-span-6 flex gap-gutter">
			{% for column in columns %}
				<div class="w-1 grow">
					{% if column.settings.list_title != blank %}
						<h6 class="{{ list_title_class }} mb-4">{{ column.settings.list_title }}</h6>
					{% endif %}
					{% for link in column.settings.link_list.links %}
						<ul class="leading-none">
							<li>
								<a href="{{ link.url }}" class="inline-block align-top {{ list_item_class }}">
									<span class="animate-underline">
										{{ link.title }}
									</span>
								</a>
							</li>
						</ul>
					{% endfor %}
				</div>
			{% endfor %}
		</div>

	</div>

	{%- comment -%} Renders nothing unless Markets offers more than one country or language {%- endcomment -%}
	{% comment %} {% render 'localization-form', class: 'pb-gutter' %} {% endcomment %}

	{%- comment -%}
		App blocks — where a Klaviyo/Mailchimp/Omnisend embed goes. Keeping this here means a
		merchant can swap the native form for their provider's own, or run both, without the
		theme hardcoding any integration.
	{%- endcomment -%}
	{%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
	{%- if app_blocks.size > 0 -%}
		<div class="mb-v-space flex flex-col gap-gutter">
			{%- for block in app_blocks -%}
				{% render block %}
			{%- endfor -%}
		</div>
	{%- endif -%}

	<div class="flex justify-between items-center border-t pt-2 border-hr-color">
		<div>
			<p class="body-tiny">©{{ "now" | date: "%Y" }}. {{ shop.name }}</p>
		</div>
		<div>
			{% for link in section.settings.small_links %}
				<ul class="leading-none flex gap-gutter">
					<li>
						<a href="{{ link.url }}" class="inline-block align-top body-small">
							<span class="animate-underline">
								{{ link.title }}
							</span>
						</a>
					</li>
				</ul>
			{% endfor %}
		</div>
		<div>
			<collapsible-trigger
				class="cursor-pointer body-tiny animate-underline"
				data-id="siteCred"
			>
				Site Credit
			</collapsible-trigger>
		</div>
	</div>
</div>
<collapsible-item id="siteCred">
	<div data-collapsible="content" class="theme-dark">
		<div>
			<div class="max-w-site-max-w py-gutter px-margin body-small text-center mx-auto">
				Site by <a class="animate-underline" href="https://hyperlinknyc.com/">Studio Hyperlink</a>
			</div>
		</div>
	</div>
</collapsible-item>

<script>
	document.querySelector('[data-id="siteCred"]').addEventListener('click', () => {
		setTimeout(() => {
			window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' })
		}, 300)
	})
</script>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "menu",
      "name": "Column",
      "settings": [
				{
          "type": "text",
          "id": "list_title",
          "label": "List Title",
					"info": "Optional"
        },
        {
          "type": "link_list",
          "id": "link_list",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
		{
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Color",
      "default": "theme-default"
    },
		{
			"type": "link_list",
			"id": "small_links",
			"label": "Small Links",
			"info": "For links to pages like privacy policy and terms"
		},
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "select",
      "id": "list_title_class",
      "label": "List title size",
      "default": "h6",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" },
        { "value": "body-tiny", "label": "Body tiny" },
        { "value": "body-small", "label": "Body small" },
        { "value": "body", "label": "Body" },
        { "value": "body-medium", "label": "Body medium" },
        { "value": "body-large", "label": "Body large" }
      ]
    },
    {
      "type": "select",
      "id": "list_item_class",
      "label": "List item size",
      "default": "body-small",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" },
        { "value": "body-tiny", "label": "Body tiny" },
        { "value": "body-small", "label": "Body small" },
        { "value": "body", "label": "Body" },
        { "value": "body-medium", "label": "Body medium" },
        { "value": "body-large", "label": "Body large" }
      ]
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "text_title",
      "label": "Sign Up Title"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Sign Up Text"
    },
    {
      "type": "text",
      "id": "text_confirm",
      "label": "Confirmation Text",
      "info": "Text that appears after a successful subscription",
      "default": "Thank you"
    }
  ]
}
{% endschema %}
