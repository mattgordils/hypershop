{% capture spacing_class %}
  {% render 'util-section-spacing' with space: section.settings.section_spacing %}
{% endcapture %}

{%-liquid
  assign section_collection = section.settings.collection | default: collection
  assign manual_list = false

  if section.settings.products != blank
    assign section_collection = section.settings
    assign manual_list = true
  endif

  assign result_count = section_collection.products_count | default: section_collection.products.size
-%}

{%- comment -%}
  Render promo cards into a string for the grid. Each renders inside its own
  Shopify block wrapper, which the block styles by id for grid placement.
{%- endcomment -%}
{%- capture promos -%}
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
{%- endcapture -%}

{% render 'breadcrumbs', class: 'px-margin pb-gutter' %}

{% if section_collection.products.size > 0 %}
  {% if manual_list %}
    {%- comment -%} A manual product list is a plain array — not paginatable {%- endcomment -%}
    {% render 'product-grid',
      products: section_collection.products,
      result_count: result_count,
      section_id: section.id,
      promos: promos,
      columns: section.settings.columns,
      tablet_columns: section.settings.tablet_columns,
      mobile_columns: section.settings.mobile_columns,
      spacing_class: spacing_class
    %}
  {% else %}
    {% paginate section_collection.products by section.settings.products_per_page %}
      {% render 'product-grid',
        products: section_collection.products,
        filters: collection.filters,
        sort_options: collection.sort_options,
        sort_by: collection.sort_by,
        results_url: collection.url,
        result_count: result_count,
        section_id: section.id,
        promos: promos,
        columns: section.settings.columns,
        tablet_columns: section.settings.tablet_columns,
        mobile_columns: section.settings.mobile_columns,
        paginate: paginate,
        pagination_style: section.settings.pagination_style,
        spacing_class: spacing_class
      %}
    {% endpaginate %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "This will override the selected collection"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "default": "numbered",
      "options": [
        { "value": "numbered", "label": "Numbered" },
        { "value": "load_more", "label": "Load more button" },
        { "value": "infinite", "label": "Infinite scroll" }
      ]
    },
    {
      "type": "select",
      "id": "section_spacing",
      "default": "medium",
      "label": "Section Spacing",
      "info": "This can be used to adjust or remove the space below this section",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Slim", "value": "slim" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "_promo-card"
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
