{% liquid
  assign wrapper_class = 'items-start'
  assign alignment = block.settings.alignment | default: 'center'
  
  if alignment == 'center'
    assign wrapper_class = 'text-center items-center mx-auto'
  endif

  if alignment == 'right'
    assign wrapper_class = 'text-right items-end ml-auto'
  endif

  if classname != blank
    assign wrapper_class = wrapper_class | append: ' ' | append: classname
  endif
%}

{% if block.blocks.size > 0 %}
  <in-view
    class="flex flex-col gap-4 {{ wrapper_class }} max-w-(--lockup-max-width)"
  >
    {% for block in block.blocks %}
      {% render block %}
    {% endfor %}
  </in-view>
{% endif %}

{% schema %}
{
  "name": "Text Lockup",
  "class": "block-text-lockup",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "default": "center",
      "label": "Text Alignment"
    }
  ],
  "blocks": [
    {
      "type": "_media-with-settings"
    },
    {
      "type": "_headline"
    },
    {
      "type": "_rich-text"
    },
    {
      "type": "_actions"
    },
    {
      "type": "_newsletter"
    }
  ],
  "presets": [
    {
      "name": "Text Lockup"
    }
  ]
}
{% endschema %}