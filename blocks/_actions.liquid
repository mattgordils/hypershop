{% capture space_below %}{% render 'util-block-spacing' with space: block.settings.space_below %}{% endcapture %}
{% if block.blocks.size > 0 %}
  <div class="flex gap-gutter flex-wrap items-center {% if block.settings.alignment == 'center' %}justify-center{% else %}justify-start{% endif %} {{ space_below | strip }}">
    {% for block in block.blocks %}
      {% render block %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Links",
  "class": "block-actions",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "space_below",
      "label": "Space Below",
      "default": "none",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" },
        { "label": "XL", "value": "xl" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "_button"
    },
    {
      "type": "_link"
    }
  ],
  "presets": [
    {
      "name": "Links"
    }
  ]
}
{% endschema %}
