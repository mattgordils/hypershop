{%- liquid
  assign page_product = product
  assign product = section.settings.product | default: product

  comment
    PDP mode writes ?variant= to the URL and re-renders the section; featured mode
    updates client-side from productJson only.

    Test identity, not whether the setting is filled: main-product's product setting is
    bound to the {{ product }} dynamic source on the product template, so it is never
    blank there. A featured-product section is one showing a *different* product, or the
    same product off a product page.
  endcomment
  assign variant_context = 'featured'
  if request.page_type == 'product' and product.id == page_product.id
    assign variant_context = 'PDP'
  endif
-%}

{% capture space_below %}{% render 'util-block-spacing', space: block.settings.space_below %}{% endcapture %}
<div data-dynamic-content class="{{ space_below | strip }}">
  {% render 'product-option-form',
    product: product,
    context: variant_context
  %}
</div>

{% schema %}
{
  "name": "Variant Selector",
  "class": "block-variant-selector",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "space_below",
      "label": "Space Below",
      "default": "medium",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" },
        { "label": "XL", "value": "xl" }
      ]
    }
  ],
  "blocks": [

  ],
  "presets": [
    {
      "name": "Variant Selector"
    }
  ]
}
{% endschema %}
