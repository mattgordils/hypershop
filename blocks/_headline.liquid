{% capture space_below %}{% render 'util-block-spacing', space: block.settings.space_below %}{% endcapture %}
<{{ block.settings.element }} class="{{ block.settings.style }} {{ space_below | strip }}">
  {{ block.settings.text }}
</{{ block.settings.element }}>

{% schema %}
{
  "name": "Headline",
  "class": "block-headline",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "default": "Headline",
      "label": "Headline Text"
    },
    {
      "type": "select",
      "id": "style",
      "default": "h2",
      "label": "Headline Style",
      "options": [
        { "label": "H1", "value": "h1" },
        { "label": "H2", "value": "h2" },
        { "label": "H3", "value": "h3" },
        { "label": "H4", "value": "h4" },
        { "label": "H5", "value": "h5" }
      ]
    },
    {
      "type": "select",
      "id": "element",
      "default": "h2",
      "label": "Headline HTML Element",
      "options": [
        { "label": "H1", "value": "h1" },
        { "label": "H2", "value": "h2" },
        { "label": "H3", "value": "h3" },
        { "label": "H4", "value": "h4" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "space_below",
      "label": "Space Below",
      "default": "none",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" },
        { "label": "XL", "value": "xl" }
      ]
    }
  ],
  "blocks": [

  ],
  "presets": [
    {
      "name": "Headline"
    }
  ]
}
{% endschema %}
