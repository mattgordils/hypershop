{%- liquid
  assign symbol = block.settings.symbol
  assign label = block.settings.label
  assign custom_icon = block.settings.custom_icon
  assign default_icon = block.settings.icon
  assign count_appearance = block.settings.count_appearance
  assign a11y_title = 'header.cart_label' | t

  assign count_prepend = ''
  assign count_append = ''
  if count_appearance == 'text'
    assign count_prepend = '('
    assign count_append = ')'
  endif
-%}

<modal-trigger
  data-modal-id="cartDrawer"
  class="header-trigger cart-trigger shrink-0 h-full px-[calc(var(--site-gutters)/2)] flex items-center gap-2 whitespace-nowrap cursor-pointer leading-none"
  role="button"
  tabindex="0"
  title="{{ a11y_title }}"
  aria-label="{{ a11y_title }}"
  {{ block.shopify_attributes }}
>
  {%- if symbol == 'circle' -%}
    <span
      id="cartCount"
      class="shrink-0 body-small w-6 h-6 flex items-center justify-center rounded-full theme-dark text-center"
      data-empty-hide="true"
    >
      {{ cart.item_count }}
    </span>
  {%- elsif symbol == 'icon' or symbol == 'custom' -%}
    <span class="shrink-0 relative flex items-center">
      {%- if symbol == 'custom' and custom_icon != blank -%}
        {{ custom_icon | image_url: width: 72 | image_tag:
          widths: '24, 48, 72',
          alt: '',
          class: 'shrink-0 block h-[18px] w-auto object-contain',
          loading: 'lazy'
        }}
      {%- else -%}
        <span class="shrink-0 material-icon text-[18px] block" aria-hidden="true">{{ default_icon }}</span>
      {%- endif -%}
      {%- if count_appearance == 'bubble' -%}
        <span
          id="cartCount"
          class="absolute -top-1.5 -right-2 min-w-4 h-4 px-1 rounded-full theme-dark text-[10px] leading-none flex items-center justify-center"
          data-empty-hide="true"
        >
          {{ cart.item_count }}
        </span>
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if label != blank -%}
    <span class="header-trigger-label shrink-0 body-small md:body">{{ label }}</span>
  {%- endif -%}

  {%- if symbol != 'circle' and count_appearance == 'superscript' -%}
    <sup id="cartCount" class="shrink-0 body-small leading-none -translate-y-1" data-empty-hide="true">
      {{ cart.item_count }}
    </sup>
  {%- elsif symbol != 'circle' and count_appearance == 'text' -%}
    <span
      id="cartCount"
      class="shrink-0 body-small md:body"
      data-prepend="{{ count_prepend }}"
      data-append="{{ count_append }}"
      data-empty-hide="true"
    >
      {%- if cart.item_count > 0 -%}{{ count_prepend }}{{ cart.item_count }}{{ count_append }}{%- endif -%}
    </span>
  {%- endif -%}
</modal-trigger>

{% schema %}
{
  "name": "Header Cart",
  "class": "block-header-cart h-full",
  "settings": [
    {
      "type": "select",
      "id": "symbol",
      "label": "Symbol",
      "default": "circle",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Circle (count only)", "value": "circle" },
        { "label": "Icon", "value": "icon" },
        { "label": "Custom Icon", "value": "custom" }
      ]
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Material icon name",
      "default": "shopping_bag",
      "info": "Any Material Symbols name (e.g. shopping_bag, shopping_cart).",
      "visible_if": "{{ block.settings.symbol == 'icon' }}"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Uploaded SVG or PNG. Falls back to the default icon if empty.",
      "visible_if": "{{ block.settings.symbol == 'custom' }}"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Leave blank to hide. Override the default \"Cart\" wording — accessibility text always uses the translated default."
    },
    {
      "type": "header",
      "content": "Item count",
      "visible_if": "{{ block.settings.symbol != 'circle' }}"
    },
    {
      "type": "select",
      "id": "count_appearance",
      "label": "Count appearance",
      "default": "bubble",
      "visible_if": "{{ block.settings.symbol != 'circle' }}",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Superscript", "value": "superscript" },
        { "label": "Bubble", "value": "bubble" },
        { "label": "Text — Cart (2)", "value": "text" }
      ]
    }
  ]
}
{% endschema %}
