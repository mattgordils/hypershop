{% liquid
  assign block_product = block.settings.product | default: product
%}

{% capture space_below %}{% render 'util-block-spacing' with space: block.settings.space_below %}{% endcapture %}

{% if block_product != blank %}
  <div class="{{ space_below | strip }}">
    {% render 'product-badges' with product: block_product %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Badges",
  "class": "block-product-badges",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "space_below",
      "label": "Space Below",
      "default": "medium",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" },
        { "label": "XL", "value": "xl" }
      ]
    }
  ],
  "blocks": [

  ],
  "presets": [
    {
      "name": "Product Badges"
    }
  ]
}
{% endschema %}
