{%- comment -%}
  Nothing but settings plumbing — the markup lives in snippets/media.liquid so a section
  can render the same image-or-video slot from flat settings, without a nested block.

  @param {string} [layout]
  @param {string} [loading]
  @param {string} [fetchpriority]
  @param {string} [sizes]
{%- endcomment -%}
{% render 'media',
  media_type: block.settings.media_type,
  image: block.settings.image,
  video: block.settings.video,
  layout: layout,
  loading: loading,
  fetchpriority: fetchpriority,
  sizes: sizes
%}

{% schema %}
{
  "name": "Media",
  "class": "block-media relative",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "default": "image",
      "label": "Media Type",
      "options": [
        {
          "label": "Image",
          "value": "image"
        },
        {
          "label": "Video",
          "value": "video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    }
  ],
  "blocks": [

  ],
  "presets": [
    {
      "name": "Media"
    }
  ]
}
{% endschema %}