{% if block.settings.text != blank and block.settings.title != blank %}
  <collapsible-item class="border-t border-hr-color" id="{{ block.id }}">
    <button data-collapsible="trigger" aria-expanded="false" aria-controls="AccordionPanel-{{ block.id }}" class="text-left flex justify-between items-center gap-x-gutter w-full py-[.75em]">
      <div class="pt-[.1em]">{{ block.settings.title }}</div>
      {%- comment -%}
        All three icons are rendered and the parent 
        accordion's data-icon-type picks one in CSS.
      {%- endcomment -%}
      <div class="h-[1em] shrink-0 grow-0 flex items-center justify-center pb-[1px]">
        <div data-collapsible="icon">
          <div data-icon-variant="chevron" class="transition" data-expanded-style="transform: rotate(180deg);">{% render 'icon-material', icon: 'keyboard_arrow_down', class: 'block' %}</div>
          <div data-icon-variant="arrow" class="transition" data-expanded-style="transform: rotate(180deg);">{% render 'icon-material', icon: 'arrow_downward', class: 'block' %}</div>
          <div data-icon-variant="plus">{% render 'icon-animated', icon: 'plus', class: 'block' %}</div>
        </div>
      </div>
    </button>
    <div id="AccordionPanel-{{ block.id }}" data-collapsible="content">
      <div>
        <div class="rich-text pb-6 max-w-[50em]">{{ block.settings.text }}</div>
      </div>
    </div>
  </collapsible-item>
{% endif %}

{% schema %}
{
  "name": "Accordion Row",
  "class": "block-accordion-row",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [

  ],
  "presets": [
    {
      "name": "Accordion Row"
    }
  ]
}
{% endschema %}