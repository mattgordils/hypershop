{% if block.settings.text != blank and block.settings.title != blank %}
  <collapsible-item class="border-t border-hr-color" id="{{ block.id }}">
    <button data-collapsible="trigger" aria-expanded="false" aria-controls="AccordionPanel-{{ block.id }}" class="{{ block.settings.title_size }} text-left flex justify-between items-center gap-x-gutter w-full py-[.75em]">
      <div class="pt-[.1em]">{{ block.settings.title }}</div>
      <div class="h-[1em] shrink-0 grow-0 flex items-center justify-center pb-[1px]">
        <div data-collapsible="icon">{% render 'icon-animated', icon: 'plus', class: 'block' %}</div>
      </div>
    </button>
    <div id="AccordionPanel-{{ block.id }}" data-collapsible="content">
      <div>
        <div class="rich-text pb-6 {{ block.settings.text_size }}">{{ block.settings.text }}</div>
      </div>
    </div>
  </collapsible-item>
{% endif %}

{% schema %}
{
  "name": "Accordion Row",
  "class": "block-accordion-row",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "title_size",
      "default": "body",
      "label": "Headline Size",
      "options": [
        {
          "label": "XL",
          "value": "h4"
        },
        {
          "label": "Large",
          "value": "h5"
        },
        {
          "label": "Medium",
          "value": "body"
        },
        {
          "label": "Small",
          "value": "body-small"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_size",
      "default": "body-small",
      "label": "Text Size",
      "options": [
        {
          "label": "Large",
          "value": "body-large"
        },
        {
          "label": "Medium",
          "value": "body"
        },
        {
          "label": "Small",
          "value": "body-small"
        },
        {
          "label": "Tiny",
          "value": "body-tiny"
        }
      ]
    }
  ],
  "blocks": [

  ],
  "presets": [
    {
      "name": "Accordion Row"
    }
  ]
}
{% endschema %}