{% capture space_below %}{% render 'util-block-spacing' with space: block.settings.space_below %}{% endcapture %}
{% if block.blocks.size > 0 %}
  <accordion-list
    class="block border-b border-hr-color {{ space_below | strip }}"
    {% if block.settings.first_open %}
      data-initial-open="0"
    {% endif %}
  >
    {% for block in block.blocks %}
      {% render block %}
    {% endfor %}
  </accordion-list>
{% endif %}

{% schema %}
{
  "name": "Accordion",
  "class": "block-accordion",
  "settings": [
    {
      "type": "checkbox",
      "id": "first_open",
      "default": true,
      "label": "First Item Open Initially"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "space_below",
      "label": "Space Below",
      "default": "none",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Small", "value": "small" },
        { "label": "Medium", "value": "medium" },
        { "label": "Large", "value": "large" },
        { "label": "XL", "value": "xl" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "_accordion-row"
    }
  ],
  "presets": [
    {
      "name": "Accordion"
    }
  ]
}
{% endschema %}
