<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#ffffff' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    {{ 'global.css' | asset_url | stylesheet_tag: preload: true }}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta_tags' %}
    {% render 'structured_data' %}
    {% render 'faq_schema' %}

    {{ content_for_header }}

    {% render 'theme-settings' %}
    {% render 'color-schemes' %}

    {% render 'integrations_before_head_close' %}
  </head>

  <body {%- if request.design_mode -%}data-shopify-editor="true"{%- endif -%}>
    <!-- Skip Links for Accessibility -->
    <a class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-main focus:text-bg focus:px-4 focus:py-2 focus:rounded" href="#main-content">Skip to main content</a>
    <a class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-32 focus:z-50 focus:bg-main focus:text-bg focus:px-4 focus:py-2 focus:rounded" href="#footer">Skip to footer</a>

    {% render 'integrations_after_body_open' %}
    
    {% comment %} <div class="sticky top-0 w-full z-6"> {% endcomment %}
      {% sections 'header-group' %}
    {% comment %} </div> {% endcomment %}
    
    {% comment %}
    {% section 'page_age-gate' %}
    {% endcomment %}
    
    <main id="main-content" role="main">
      <div class="page-sections">
        {{ content_for_layout }}
        {% comment %} {%- if request.design_mode -%} {% endcomment %}
          <details>
            <summary class="z-10 fixed bottom-0 left-0 w-full p-4 pointer-events-none flex items-center justify-center">
              <p class="button pointer-events-auto">View Styleguide</p>
            </summary>
            <div
              class="fixed inset-0 z-9 overflow-auto theme-default"
            >{% section 'styleguide' %}</div>
          </details>
        {% comment %} {%- endif -%} {% endcomment %}
      </div>
    </main>

    {% section 'page_cart-panel' %}
    {% sections 'footer-group' %}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>

    {%- if request.design_mode -%}
      <script src="{{ 'shopify-editor.js' | asset_url }}" defer></script>
    {%- endif -%}

    {% section 'page_menu-panel' %}

    {% render 'integrations_before_body_close' %}

  </body>
</html>
